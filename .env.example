# 복사해서 .env로 만들고 값을 채우세요. .env는 저장소에 올리지 않습니다(.gitignore).
# docker compose가 이 파일을 자동으로 읽습니다.

# 필수: 기본값이 없어 비워 두면 실행되지 않습니다. 추측하기 어려운 값을 쓰세요.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 대시보드(React)를 서비스하는 주소. 쉼표로 여러 개 지정할 수 있습니다.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 응답의 dateTime을 표시할 시간대(DB에는 항상 UTC로 저장)
SAFETYALL_TIMEZONE=Asia/Seoul
